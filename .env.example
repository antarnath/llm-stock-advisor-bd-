# =============================================================================
# .env.example — Template for local secrets (committed to repo)
# =============================================================================
# Copy this file to `.env` and fill in your real keys:
#     cp .env.example .env
# The `.env` file is gitignored (see .gitignore section 1).
#
# Loaded automatically by backend/db.py on import via python-dotenv.
# Real shell env vars always win over .env values.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM Provider (Phase 10 — orchestrator)
# -----------------------------------------------------------------------------
# Pick one: stub | openrouter | groq | gemini | nim
#   - stub        : offline, no key needed (template fallback)
#   - groq        : free tier, fast — https://console.groq.com/keys
#   - openrouter  : free tier, many models — https://openrouter.ai/keys
#   - gemini      : free tier via Google AI Studio — https://aistudio.google.com/apikey
#   - nim         : NVIDIA endpoint — https://build.nvidia.com/
#
# Switch provider here + set the matching _API_KEY below, then POST /settings
# or restart uvicorn — the orchestrator rebuilds with the new client.
ADVISOR_LLM_PROVIDER=stub

# Model override (optional; defaults are picked per provider if blank)
ADVISOR_LLM_MODEL=

# --- API keys (paste real values into your .env, NOT this template) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
NIM_API_KEY=

# --- Optional base-URL overrides (leave blank to use provider defaults) ---
GROQ_BASE_URL=
OPENROUTER_BASE_URL=
GOOGLE_BASE_URL=
NIM_BASE_URL=


# -----------------------------------------------------------------------------
# News / market-data APIs (used by Phase 6 sentiment + data collection)
# -----------------------------------------------------------------------------
NEWS_API_KEY=
ALPHAVANTAGE_API_KEY=


# -----------------------------------------------------------------------------
# Legacy / optional (kept for reference; not currently wired)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
DATABASE_URL=
SECRET_KEY=
REDIS_URL=
NEXT_PUBLIC_API_URL=
