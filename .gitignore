# =============================================================================
# .gitignore — LLM-Orchestrated Financial Advisor (Bangladesh DSE)
# =============================================================================
# Strategy: MINIMAL ignore. Only block files that risk hitting GitHub's
# 100 MB-per-file hard limit or that are clearly non-source clutter.
# ALL .md files are ignored (kept locally only).
#
# GitHub size limits:
#   - Hard reject:  > 100 MB per file
#   - Soft warning:   50–100 MB per file
#   - Repo guidance:  < 1 GB total
#
# Anything NOT matched below will be tracked. If a file is legitimately
# too big (>100 MB), add its extension/pattern here.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Secrets & credentials (NEVER commit)
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
credentials/

# -----------------------------------------------------------------------------
# 2. Python virtualenv / build artifacts (huge, regenerable)
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# -----------------------------------------------------------------------------
# 3. IDE / editor
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# 4. OS clutter
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
Thumbs.db

# -----------------------------------------------------------------------------
# 5. Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# 6. Testing / coverage / type-check caches
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
.cache/
.pyright/
.mypy_cache/

# -----------------------------------------------------------------------------
# 7. Docker / CI runtime artifacts
# -----------------------------------------------------------------------------
docker-compose.override.yml
*.pid
*.seed

# -----------------------------------------------------------------------------
# 8. Logs (regenerated on every run)
# -----------------------------------------------------------------------------
logs/*.log
logs/*.log.*
logs/*.err
logs/*.out
!logs/.gitkeep

# -----------------------------------------------------------------------------
# 9. Git LFS catch-all safety net
# -----------------------------------------------------------------------------
# If any single file ever exceeds GitHub's 100 MB hard limit, the pattern
# below guarantees it is never attempted. 100 MB is the hard reject.
# (Uncomment to enforce. Currently nothing in the repo exceeds 100 MB.)
# *.blob.large

# -----------------------------------------------------------------------------
# 10. Ignore ALL .md files (kept locally only)
# -----------------------------------------------------------------------------
# All Markdown documentation — README.md, docs/**, phase specs,
# PROGRESS.md, overview.md, sub-folder READMEs, *_NOTES.md — stays
# on the local machine and is NEVER pushed to GitHub.
# *.md
# README.md
# docs/**/*.md
# overview.md
# *_NOTES.md

# Also ignore the large top-level guide text file (kept local)
COMPLETE_PROJECT_GUIDE.txt
*_GUIDE.txt
NOTES.txt

# -----------------------------------------------------------------------------
# 11. Frontend (Phase 12) — Next.js / Tailwind build artifacts + deps
# -----------------------------------------------------------------------------
frontend/.next/
frontend/node_modules/
frontend/.env.local
frontend/out/

# -----------------------------------------------------------------------------
# 12. Phase 13 — runtime-overridable LLM config (may contain API keys)
# -----------------------------------------------------------------------------
data/external/api/llm_settings.json

# -----------------------------------------------------------------------------
# 13. Trained model files (regenerable from src/training/ scripts)
# -----------------------------------------------------------------------------
*.pt
*.pkl
*.joblib
*.bin
*.h5
*.hdf5
*.onnx
*.safetensors
models/

# -----------------------------------------------------------------------------
# 14. Raw + processed data CSVs (regenerable from src/data_collection/)
# -----------------------------------------------------------------------------
data/raw/stocks/*.csv
data/raw/indices/*.csv
data/raw/news/*.csv
data/processed/*_processed*.csv
data/processed/_last_refresh.json
data/external/*.csv

# -----------------------------------------------------------------------------
# 15. Report artifacts (large, regenerable)
# -----------------------------------------------------------------------------
report.zip
report bluprint.jpg
report_bluprint.jpg
report_bluprint*.jpg
*.zip

# -----------------------------------------------------------------------------
# 16. Local trash / scratch folder (never tracked)
# -----------------------------------------------------------------------------
# Used to quarantine obsolete files (old PPT scripts, old guides, etc.)
# before permanent deletion. Delete with: rm -rf trash/
trash/


# -----------------------------------------------------------------------------
# End of .gitignore
# -----------------------------------------------------------------------------
dataset_hf/
models/rag/
results/rag_corpus_truncated.csv
backend/.settings.json
