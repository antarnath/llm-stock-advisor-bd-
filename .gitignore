# =============================================================================
# .gitignore — LLM-Orchestrated Financial Advisor (Bangladesh DSE)
# =============================================================================
# This file prevents large / sensitive / regenerated artifacts from being
# committed to git. The repo is meant to track SOURCE CODE and CONFIG, not
# raw data, trained models, plots, or local debug output.
#
# Sections:
#   1. Python
#   2. Virtual environments & secrets
#   3. IDE / editor
#   4. OS clutter
#   5. Jupyter
#   6. Testing / coverage
#   7. Docker / CI
#   8. Logs (regenerated on every run)
#   9. Models (binary, large — re-train via scripts/run_pipeline.py)
#  10. Results / plots / reports (regenerated by visualize.py)
#  11. Data (raw CSVs from DSE scraping; processed features re-generated)
#  12. Project-specific: test scripts, backups, debug artifacts
#  13. Archives / large binary blobs
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# -----------------------------------------------------------------------------
# 2. Virtual environments & secrets
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version
.env
.env.local
.env.*.local
!.env.example

# API keys / credentials (defence in depth — never commit)
*.pem
*.key
secrets/
credentials/

# -----------------------------------------------------------------------------
# 3. IDE / editor
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# 4. OS clutter
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# 5. Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# 6. Testing / coverage
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
.cache/
.pyright/
.mypy_cache/

# -----------------------------------------------------------------------------
# 7. Docker / CI
# -----------------------------------------------------------------------------
docker-compose.override.yml
*.pid
*.seed

# -----------------------------------------------------------------------------
# 8. Logs (regenerated on every run)
# -----------------------------------------------------------------------------
logs/*.log
logs/*.log.*
logs/*.csv
logs/*.txt
logs/*.json
logs/*.err
logs/*.out
!logs/README.md
!logs/.gitkeep

# -----------------------------------------------------------------------------
# 9. Documentation (NOT pushed — kept locally only)
# -----------------------------------------------------------------------------
# All phase documentation, progress notes, architecture docs, and high-level
# guides remain on the local machine. They contain thesis-related text that
# the user does not want on GitHub.
docs/**
docs/
!docs/.gitkeep
!docs/**/.gitkeep

# Top-level guides and notes (also kept local)
overview.md
COMPLETE_PROJECT_GUIDE.txt
NOTES.txt
*_NOTES.md
*_GUIDE.txt

# -----------------------------------------------------------------------------
# 10. Models (binary, large — re-train via scripts/run_pipeline.py)
# -----------------------------------------------------------------------------
# All trained model artifacts. The pipeline re-creates them from
# data/processed/*_processed_v2.csv + src/training/baseline_trainer_v2.py.
# Total size per stock: 1KB-3MB. Total repo would balloon to ~30MB+
# for 30 stocks x 4 models. Excluded by default.
models/**/*.pkl
models/**/*.pt
models/**/*.pth
models/**/*.h5
models/**/*.hdf5
models/**/*.onnx
models/**/*.joblib
models/**/*.bin
models/**/*.safetensors
models/**/*.gguf
# Keep folder structure (placeholders only)
!models/baseline/.gitkeep
!models/deep_learning/.gitkeep
!models/transformers/.gitkeep
!models/experiments/.gitkeep

# -----------------------------------------------------------------------------
# 11. Results / plots / reports (regenerated by visualize.py)
# -----------------------------------------------------------------------------
# Per-stock results, all plots, summary reports. Regenerated by
# src/evaluation/visualize.py + src/inference/predict_v2.py.
results/**/*.png
results/**/*.jpg
results/**/*.jpeg
results/**/*.pdf
results/**/*.svg
results/**/*.csv
results/**/*.txt
results/**/*.json
results/**/*.html
# Exceptions: keep folder structure + any hand-written README
!results/baseline/.gitkeep
!results/**/README.md
!results/**/.gitkeep

# -----------------------------------------------------------------------------
# 12. Data (raw + processed)
# -----------------------------------------------------------------------------
# Raw DSE data should be re-collected from source (src/data_collection/).
# Processed features are deterministic and re-generated by
# src/data_processing/technical_indicators_v2.py.
#
# Total raw data: ~30 stocks × ~4300 rows = ~130k rows × ~12 cols ≈ 50MB+.
# Total processed data: same row count × 40 cols ≈ 200MB+.
# Excluded to keep the repo lean.
#
# Order matters: broader patterns first, then negations.

# Broad: ignore ALL data files anywhere under data/
data/**/*.csv
data/**/*.tsv
data/**/*.json
data/**/*.parquet
data/**/*.xlsx
data/**/*.xls
data/**/*.html
data/**/*.xml
data/**/*.feather
data/**/*.arrow
data/**/*.h5
data/**/*.hdf5

# Broad: ignore EVERYTHING inside data/ subdirs, then re-allow placeholders
data/raw/stocks/*
data/raw/indices/*
data/processed/*
data/external/*

# Negations (re-allow these specific files)
!data/raw/stocks/.gitkeep
!data/raw/indices/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Re-allow processing-summary CSVs (small, useful for debugging)
!data/processed/_processing_summary*.csv

# Re-allow hand-written READMEs
!data/raw/README.md
!data/processed/README.md
!data/external/README.md

# -----------------------------------------------------------------------------
# 13. Project-specific
# -----------------------------------------------------------------------------

# Quick test scripts (created during development for local testing only)
# These are NOT part of the production pipeline.
/test.py
/test_*.py
/_test*.py

# Old/backup versions of code (we use _v2 suffix for live code)
src/**/baseline_trainer.py
src/**/predict.py
src/**/technical_indicators.py
src/**/*_v1.py
src/**/_v1/

# Backup of the LEAKY baseline_results (kept locally for comparison,
# but not part of the active project — too large and confusing on GitHub)
results/baseline_LEAKY_backup/
results/baseline_LEAKY_backup/**

# Old/broken pipeline artifacts
*.bak
*.old
*.orig
*.tmp
*.swp
*.swo
*.rej

# One-off debug scripts (regenerated as needed)
scripts/debug/
scripts/debug/**
/scripts/debug/__pycache__/
/scripts/debug/*.pyc

# Compiled pickle cache (Python's auto-generated)
/src/**/__pycache__/
/src/**/*.pyc
/src/**/*.pyo

# -----------------------------------------------------------------------------
# 14. Archives / large binary blobs
# -----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.tar.xz
*.txz
*.7z
*.rar
*.gz
*.bz2
*.xz
*.lzma
*.dmg
*.iso
*.img
*.msi
*.deb
*.rpm
*.apk
*.ipa

# Media files (not used but just in case)
*.mp4
*.mov
*.avi
*.mp3
*.wav
*.flac
*.ogg
*.webm

# Disk image / VM files
*.vmdk
*.vdi
*.vhd
*.qcow2
*.ova
*.ovf

# -----------------------------------------------------------------------------
# End of .gitignore
# -----------------------------------------------------------------------------
